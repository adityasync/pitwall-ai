# PITWALL.AI env — copy to .env.local and fill in real values.
# Never commit keys (docs/09-DEPLOYMENT.md). This file holds placeholders only.
# Server only:
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5-flash
# Ask-answer cache (Neon Postgres, optional — Ask works without it):
DATABASE_URL=
# Client:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional override for where race JSON is served from:
# NEXT_PUBLIC_DATA_BASE=
# Live data service (service/app.py on Render). When set, the app reads race
# JSON from the service first and falls back to static files. Leave empty for
# static-only mode (submission-safe default).
NEXT_PUBLIC_API_BASE=
# Shared secret for POST /v1/ingest on the service. Generate one per deploy
# (render.yaml generateValue does it) — never commit the real value.
INGEST_SECRET=

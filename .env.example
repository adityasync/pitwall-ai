# PITWALL.AI env — copy to .env.local and fill in real values.
# Never commit keys (docs/09-DEPLOYMENT.md). This file holds placeholders only.
# Server only:
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5-flash
# Optional paid live feed:
OPENF1_TOKEN=
# Ask-answer cache (Neon Postgres, optional — Ask works without it):
DATABASE_URL=
# Client:
NEXT_PUBLIC_LIVE=0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional override for where race JSON is served from:
# NEXT_PUBLIC_DATA_BASE=
